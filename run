#!/usr/bin/env bash
set -e
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
# build/ é a pasta do INSTALL.md (15/11/2026); a antiga
# build-reactivation-20260915 ficou presa ao caminho de antes da mudança de
# lugar do projeto e só serve de reserva.
app=./build/src/app/AquorbiumApp_artefacts/Release/Aquorbium
[[ -x "$app" ]] || app=./build-reactivation-20260915/src/app/AquorbiumApp_artefacts/Release/Aquorbium
if [[ ! -x "$app" ]]; then
    printf 'Aquorbium não compilado. Execute: cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DAQUORBIUM_JUCE_PATH=<JUCE> && cmake --build build --target AquorbiumApp --parallel 2\n' >&2
    exit 1
fi
if [[ "${1:-}" == diagnostico ]]; then
    shift
    if [[ "$#" -ne 0 ]]; then
        printf 'Uso: ./run diagnostico\n' >&2
        exit 1
    fi
    session="$PWD/validation-output/escuta-$(date +%Y%m%d-%H%M%S)"
    printf 'Captura de 60 s no áudio interno: %s\n' "$session"
    exec timeout --kill-after=5s 75s "$app" \
        "--capture-audio=$session" \
        '--capture-output=Default ALSA Output (currently PipeWire Media Server)' \
        --capture-seconds=60
fi
exec "$app" "$@"
